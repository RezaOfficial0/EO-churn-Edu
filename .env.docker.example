# docker compose'un okuduğu ayarlar.
#
#     cp .env.docker.example .env.docker
#
# Bu dosya `.env`'DEN AYRI ve öyle kalmalı. Yereldeki `.env` "localhost"a bakar
# (venv ile geliştirirken kullandığın), bu dosya compose ağındaki "db" servisine.

# DEMO CREDENTIALS. Change POSTGRES_PASSWORD on any machine that is not your own
# laptop: docker-compose.yml publishes Postgres on the host's DB_PORT, so this
# password is all that stands between the student roster and anything that can
# route to the host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=eochurn
POSTGRES_DB=eo_churn

# Container içinde "localhost" container'ın kendisidir. Postgres "db" servisinde.
DATABASE_URL=postgresql://postgres:eochurn@db:5432/eo_churn

DATA_SOURCE=db

# Host tarafı portlar. Makinende doluysa burada değiştir.
API_PORT=8000
DB_PORT=5432
DASHBOARD_PORT=5173

# Tarayıcı senin makinende çalıştığı için dashboard API'ye dış port üzerinden
# ulaşır. DASHBOARD_PORT'u değiştirirsen burayı da değiştir.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The address the BROWSER uses to reach the API. Baked into the dashboard bundle
# at BUILD time, so changing it needs a rebuild (`--build`), not a restart.
# It must match API_PORT above. Never "http://api:8000" - "api" only resolves
# inside the compose network, and the browser is not in it.
VITE_API_BASE=http://localhost:8000

# Boş = kimlik doğrulama TAMAMEN kapalı: porta erişebilen herkes öğrenci
# id'lerini ve 24 feature değerini okuyabilir, POST /run-daily-pipeline'ı
# çağırabilir. Yerel demo için doğru, başka her yerde değil.
# UYARI: dashboard henüz X-API-Key gönderemiyor, yani burayı doldurmak
# dashboard'u kırar. İkisini birden istiyorsan header'ı ekleyen bir proxy gerek.
API_KEY=

# Boş = sadece ekrana yazar, kimseye mesaj gitmez.
NOTIFY_CHANNELS=
NOTIFY_TITLE="EO-Churn — Günlük Risk Uyarısı"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
