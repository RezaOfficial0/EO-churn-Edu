# Copy this file to `.env` and fill in the values you need.
# `config.py` loads `.env` automatically (via python-dotenv) on import.
# Every variable here is optional; sensible defaults are used when unset.

# Where the DAILY pipeline reads students from and writes alerts to: "csv" or "db".
#   csv - data/daily_data.csv in, data/daily_alerts.csv out (the default)
#   db  - the daily_students and alerts tables in DATABASE_URL
# Training always reads CSV and ignores this setting.
DATA_SOURCE=csv

# Postgres connection string. Required only when DATA_SOURCE=db.
# The value below is a PLACEHOLDER, not a default - replace USER/PASSWORD/HOST
# or leave it empty. Left as-is it looks configured and fails at connect time.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eo_churn

# Read ONLY by the test suite (tests/test_db_integration.py). Point it at a
# THROWAWAY database: every database test truncates daily_students and alerts
# before it runs. Deliberately not DATABASE_URL, so `pytest` in a shell set up
# for development can never reach the database you actually use.
#   createdb eo_churn_test
#   TEST_DATABASE_URL=postgresql://postgres@localhost:5432/eo_churn_test pytest
# Unset (the default) makes the 9 database tests skip.
TEST_DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API (CORS).
# Leave unset to allow the local dev servers below.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret required in the `X-API-Key` request header.
# EMPTY NO LONGER MEANS "AUTH OFF" - it means the API REFUSES TO START. Every
# response here carries student ids and 24 behavioural features, so an open port
# is not something a blank line in a template gets to decide. Note the dashboard
# cannot send this header yet, so setting it will break the dashboard until a
# proxy adds it.
API_KEY=

# The address the API is reachable on: uvicorn's --host, or the address Docker
# publishes the port on. Unset is treated as PUBLIC (0.0.0.0) on purpose, because
# an unknown exposure must not read as a safe one.
API_BIND_HOST=127.0.0.1

# The only way to run without a key, for local development. Requires a loopback
# API_BIND_HOST; anything else is still refused.
#   EOAI_ALLOW_NO_AUTH=1
EOAI_ALLOW_NO_AUTH=

# --- Daily alert notifications ----------------------------------------------
# Which channels `scripts/send_daily_alerts.py` delivers to. Comma-separated,
# any of: telegram, email, webhook.
# Leave EMPTY on a development machine - the alert is then only printed, so a
# test run never messages a real mentor.
NOTIFY_CHANNELS=

# Heading shown at the top of every alert message.
NOTIFY_TITLE=EO-Churn — Günlük Risk Uyarısı

# Telegram. Create a bot by messaging @BotFather (/newbot) - it hands you the
# token. For the chat id: send your bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[0].message.chat.id
# (a group chat id is negative, e.g. -1001234567890).
#
# The token's shape is checked before it is used (<digits>:<letters/digits>), so a
# stray quote, space or line break here fails fast with a clear message instead of
# printing the token in a urllib error. Surrounding whitespace is stripped for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP. For Gmail, SMTP_PASSWORD must be an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal password.
# Unlike the other secrets, SMTP_PASSWORD is used exactly as written - a password
# may legitimately end in a space - so do not leave a trailing space or newline
# here by accident.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients.
SMTP_TO=
# true = STARTTLS on port 587 (usual). false = implicit SSL on port 465.
SMTP_STARTTLS=true

# Webhook (Slack / Discord "incoming webhook" URL, or anything that accepts
# a JSON body of {"text": "..."}).
ALERT_WEBHOOK_URL=

# --- Scheduler and operator alerting (B-14) ---------------------------------
# The daily run is no longer a cron line you add by hand: the `scheduler` service
# in docker-compose.yml runs `scripts/scheduler.py`, which waits for the time below
# and then runs the pipeline and the alert send, chained with `&&`.

# Local time of day (HH:MM) and the zone it is expressed in. The zone matters: the
# container's clock is UTC, so 09:00 without Europe/Istanbul would reach a mentor
# at noon. An unparseable RUN_AT makes the scheduler EXIT rather than guess.
RUN_AT=09:00
SCHEDULER_TIMEZONE=Europe/Istanbul

# Which weekdays to run on, Mon=1 .. Sun=7. Empty = every day.
#   RUN_DAYS=1-5    weekdays only (what the old cron line did)
# With 1-5, raise SCHEDULER_HEARTBEAT_HOURS to ~74 or Monday morning looks like an
# outage: the last successful run was on Friday.
RUN_DAYS=

# No successful run in this many hours -> an alert to the OPS channel below, and
# the scheduler container reports itself unhealthy. This is the check that tells
# "nobody is at risk today" apart from "the system has been dead for three days".
SCHEDULER_HEARTBEAT_HOURS=26

# Where the last-success / last-failure record is kept. Default: ./state/ next to
# config.py; in compose it is a named volume so it survives a rebuild. A file
# because no table may hold it yet - the `runs` table is B-04.
SCHEDULER_STATE_PATH=

# A single step may not take longer than this (seconds). A hung database
# connection would otherwise make the scheduler look alive with nothing running.
SCHEDULER_RUN_TIMEOUT_SECONDS=3600

# --- Where a FAILED run is reported -----------------------------------------
# Deliberately NOT the channels above. Those go to the customer's mentors; a
# failed run is our problem, and "KeyError in daily_pipeline" is not something a
# mentor can act on. Same Telegram bot (TELEGRAM_BOT_TOKEN above), our chat.
#
# Create a second group, add the bot to it, and read the id with:
#   python scripts/telegram_setup.py
OPS_TELEGRAM_CHAT_ID=

# Or a separate Slack/Discord incoming webhook for the ops channel. This URL IS a
# credential and is redacted everywhere, like the customer one.
OPS_ALERT_WEBHOOK_URL=

# Both empty is allowed: the failure is then only in `docker compose logs
# scheduler` and in the scheduler service's (unhealthy) status. Set at least one
# before a pilot - nobody watches a log.



LLM_SERVICE_URL=
LLM_SERVICE_KEY=
LLM_TIMEOUT=
CAMPAIGN_FEATURE=
